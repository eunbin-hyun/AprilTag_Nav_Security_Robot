# 백엔드 설정 예시. 실제 .env는 커밋하지 않는다(.gitignore).
#
# ⛔ **값을 비워 두는 것과 줄을 지우는 것은 다르다.** `Settings`에 필드가 있으면 빈 값도
#    "있는 값"이라 코드 기본값이 **안 걸린다**(app/config.py). 안 정한 값은 비우지 말고 줄을
#    통째로 지우거나 `#`로 막는다. 2026-08-04에 실물로 재 봤다.
#    - 비워 두는 게 정상인 값은 코드 기본값도 빈 값인 것들뿐이다 — 키·웹훅류(DASHBOARD_API_KEY,
#      MATTERMOST_*, GMS_API_KEY, KMA_SERVICE_KEY). 이 넷은 비우면 그 기능만 조용히 꺼진다.
#    - 주소류(CAMERA_STREAM_URL·WEATHER_API_URL처럼 기본값이 빈 값이 **아닌** 설정)를 비우면
#      기본값으로 안 돌아가고 **빈 주소로 나간다.** 카메라는 창이 통째로 502이고, wttr 1차는
#      그 고리를 헛돌고 대체 도메인이 대신 받는다. 아래 각 자리에 ⛔로 적어 뒀다.
#    - 숫자·참거짓 설정을 비우면 서버가 아예 기동을 못 한다(pydantic ValidationError).
#      이건 조용하지 않아서 오히려 낫다 — 컨테이너가 안 뜨면 이 자리부터 본다.
#
# 로컬 개발(싸피노트북 PostgreSQL 16, 5432): 비밀번호는 팀 비밀 저장소에서 받는다.
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@127.0.0.1:5432/c207
# 기기 키. 인입 API와 로봇 WS 채널이 쓴다. 배포 때 반드시 유일한 값으로 덮어쓴다.
# ⚠ 이 기본값 그대로면 WS 인증을 켜도 접속이 전부 닫힌다 — 저장소에 적혀 있는 값이라
#   자물쇠 구실을 못 한다. 켤 배포에는 실값을 넣는다.
API_KEY=dev-local-key
# 대시보드(브라우저) WS 채널 전용 키. API_KEY와 **다른 값**을 넣는다.
# 브라우저가 기기 키를 들면 개발자 도구에 그대로 보이고, 그 한 장이 인입·명령 창구까지 연다.
# 그래서 /ws/dashboard는 이 값만 받는다. 비워 두면 대시보드 스위치를 켤 때 전부 닫힌다.
# ⚠ 이 키도 화면에 노출되는 값이라 "사람용 인증"이 아니다. 임시 자물쇠이고 최종은 M-6이다.
DASHBOARD_API_KEY=
# 대시보드 WS 메시지 version 필드
WS_PROTOCOL_VERSION=1
# WebSocket 핸드셰이크에 키를 요구할까. 셋 다 기본 false다.
# 키 창구는 세 자리를 동급으로 받는다 — X-API-Key 헤더 / Authorization: Bearer <키> /
# ?api_key= 쿼리. 젯슨 web_bridge는 Bearer로 싣고, 브라우저는 헤더를 못 실어 쿼리뿐이다.
# ⚠ 켜는 순간 그 채널에 붙는 쪽이 전부 키를 실어야 한다 — 현장 배선이 같이 움직여야 하는
# 결정이라 켜는 시점은 팀이 정한다(아키텍처 M-6 "정식 인증").
# 상위 스위치. 켜면 아래 둘과 상관없이 두 채널 다 켜진다.
# WS_REQUIRE_API_KEY=false
# 로봇 채널(/ws/robot)만. 젯슨·라파이 배선이 끝나면 여기부터 켠다.
# WS_REQUIRE_API_KEY_ROBOT=false
# 대시보드 채널(/ws/dashboard)만. 받는 키는 위 DASHBOARD_API_KEY다(API_KEY 아님).
# ⚠ 프론트가 키를 실을 수 있게 고쳐지기 전에 켜면 화면이 무한 재접속만 돈다. 켜는 순서는
#   backend/README.md "WS 핸드셰이크 인증"에 있다. 쿼리 키는 nginx 액세스 로그에 통째로
#   남으니 화면 경계는 프록시 인증·세션 쿠키로 옮기는 게 최종이다.
# WS_REQUIRE_API_KEY_DASHBOARD=false
# 미태깅 경고를 밀어낼 매터모스트 Incoming Webhook (S15P11C207-82).
# 비워 두면 아무 데도 안 쏜다. 값을 넣는 순간부터 실제로 팀 채널에 카드가 붙으니
# 시험용 채널로 먼저 받아 보고 옮긴다. URL을 남겨 둔 채 발사만 멈추려면 MATTERMOST_ENABLED=false.
MATTERMOST_WEBHOOK_URL=
# MATTERMOST_ENABLED=false
# 미태깅 통과자 신원이 관제 화면에 입력됐을 때 보고가 나갈 두 번째 채널(상위 보고선).
# 위 미태깅 채널과 별개다. 비워 두면 입력만 남고 아무 데도 안 쏜다(기본).
# ⚠ 이 채널에는 요원이 적어 넣은 신원이 안 가려진 채로 붙는다. 아무 채널이나 넣지 말고
# 보고선에 해당하는 채널을 따로 파서 그 주소를 넣는다.
MATTERMOST_IDENTIFY_WEBHOOK_URL=
# ── 통계에서 시험 자료 빼기 (기본 꺼짐) ──────────────────────────────────────
# /api/stats/untagged·/api/stats/today가 세는 모집단을 좁힌다. 꺼져 있으면 아래 두 축을
# 채워도 아무 일도 안 일어나고 집계는 예전과 똑같다. 시연에서 어느 숫자를 보여줄지가
# 아직 안 정해져서 스위치로 뒀다(팀 결정 대기).
# STATS_EXCLUDE_TEST_DATA=false
# 시험 기기 device_id 접두(콤마로 여럿). 셔틀은 device_id가 없어 event_id 접두로 본다.
# ⚠ webcall-은 넣지 마라. 화면 셔틀 가상 호출 접두인데 셔틀은 실기기를 안 만들어서 그게
# 시연의 유일한 셔틀 경로다 — 시험 취급하면 셔틀 건수가 통째로 0으로 나온다.
# STATS_TEST_DEVICE_PREFIXES=test-
# 이 시각 앞 자료를 안 센다. 실서버 자료는 device_id가 전부 raspberry01이라(2026-07-30 실측)
# ToF 오검출을 빼는 축은 지금 이거 하나다.
# ⚠ 오프셋(+09:00)을 반드시 적어라. 안 적은 2026-07-30T00:00:00은 에러가 안 나고 그대로
# 통과하는데, 보정이 없으면 서버 프로세스 로컬 시간대로 읽혀 기계마다 컷이 달라진다 —
# 한국 개발 기계는 KST, TZ=UTC인 도커 컨테이너는 UTC로 아홉 시간 어긋난다(그날 아침
# 9시간이 통계에서 빠진다). 서버가 오프셋 없는 값은 KST로 못박고 경고 로그를 남기지만
# (app/stats.py의 _assume_kst), 짐작하게 두지 말고 여기 적는 편이 낫다.
# ⚠ 이 축을 켜면 미처리 경고 수가 창구마다 갈린다. /api/stats/today는 이 컷을 타고
# /api/dashboard/snapshot(count_active_alerts)과 관제 보조는 안 탄다 — 켤 때 같이 통일해라.
# STATS_EXCLUDE_BEFORE=2026-07-30T00:00:00+09:00
# 관제 보조 LLM (GMS OpenAI 호환 프록시). 비워 두면 LLM을 안 부르고 규칙 기반 문장으로 답한다.
# 실키는 팀 비밀 저장소에서 받아 이 파일이 아니라 .env에만 넣는다(.env는 커밋 제외).
GMS_API_KEY=
# 아래 셋은 기본값이 코드에 있어 보통 안 적는다. 프록시나 모델을 바꿀 때만 쓴다.
# GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1
# GMS_MODEL=gpt-5.4-mini
# GMS_TIMEOUT_SEC=8.0
#
# ⛔ **온프레미스(로컬 LLM)로 돌릴 때 — 주소만 바꾸면 LLM을 아예 안 부른다.**
#    `api_key`가 비면 `enabled`가 False라 호출 전에 폴백으로 빠진다. 우리 llama-server는
#    인증이 없어서 키가 필요 없는데, 코드는 "키가 없다 = 끔"으로 읽는다.
#    → **더미 값을 넣는다.** 이름이 뜻을 말하게 적는다(그냥 `local`이면 다음 사람이
#      "키가 들어 있네"로 읽는다).
#
#    GMS_API_KEY=local-no-auth-required
#    GMS_BASE_URL=http://172.18.0.1:18000/v1
#    GMS_MODEL=qwen3.6-27b
#    GMS_TIMEOUT_SEC=20
#    ASSISTANT_DAILY_LLM_CALLS=3000
#
# ⚠ **`GMS_TIMEOUT_SEC`은 nginx보다 확실히 작아야 한다.** `deploy/nginx-c207-api.conf`의
#    관제 보조 블록이 `proxy_read_timeout 60s`다. 둘이 같아지면 백엔드가 59초에 답해도
#    위에서 먼저 끊어 504가 나가고 폴백 문장조차 화면에 못 간다.
# ⚠ `env_file`은 컨테이너를 만들 때 읽혀 굳는다. **컨테이너 재생성까지 가야 먹는다.**

# 하루에 LLM을 몇 번까지 부르나. 넘기면 규칙 문장이 나가고 meta.fallback_reason이
# daily_budget으로 말한다. 안 적으면 300이다.
# ⚠ **0 이하는 "무제한"이 아니라 "끄기"다** — LLM을 아예 안 부른다.
# ⭐ GMS는 호출마다 크레딧을 태우므로 300이 안전판이다. 로컬 LLM은 크레딧을 안 쓰니 올린다.
# ASSISTANT_DAILY_LLM_CALLS=300

# ── 셔틀 도착 → 출동 대기 창 (셔틀출동 설계 2026-07-31) ──────────────────────
# 셔틀 신호를 받고 목적지 명령을 붙들고 있는 시간(초). 이 창 안에 요원이 실내·실외·대기 중
# 하나를 고르면 그대로 나가고, 아무도 안 고르면 그날 기본 목적지로 자동 발사한다.
# ⚠ 값이 셔틀 호출 쿨다운(코드 상수 SHUTTLE_CALL_COOLDOWN_SEC)과 정확히 같은 5.0초다.
# 하는 일은 정반대다 — 쿨다운은 입구에서 두 번째 호출을 429로 삼키고, 이 값은 이미 받아들인
# 신호 하나를 붙든다. 로그 머리로 갈라 읽는다([게이트 연타 차단] ↔ [출동 대기 창]).
# 0 이하로 두면 대기 없이 예전처럼 즉시 발사한다.
# SHUTTLE_DISPATCH_HOLD_SEC=5.0
# ── 날씨 (기상청 단기예보 조회서비스 · 2026-08-03 전환) ───────────────────────
# ⭐⭐ 이 절에서 **손으로 채우는 값은 KMA_SERVICE_KEY 하나뿐이다.** 나머지는 기본값이 코드에 있다.
#
# ⛔ **비워 두면 에러가 하나도 안 난다.** 기상청 경로를 아예 건너뛰고 아래 wttr 사슬로 조용히
#    빠진다(app/weather.py fetch_current_weather). 화면에는 날씨가 그대로 뜬다 — 그래서 못 알아챈다.
#    ⚠ **로그에도 흔적이 안 남는다.** "기상청 — KMA_SERVICE_KEY가 비어 있어 안 탄다" 문구는
#    logger가 아니라 사유 리스트로 담기고, 그 리스트가 로그로 나가는 자리는 **wttr 사슬까지 전부
#    실패한 판 하나뿐**이다(_fallback). 키가 없고 wttr가 받는 정상 갈래는 "날씨 조회 성공" 한 줄로
#    끝난다. 그러니 그 문구를 grep해서 0건인 것은 **키가 들어 있다는 뜻이 아니다**(2026-08-04 실측).
#    ⚠ 시간대별 예보 창구(GET /api/weather/forecast)만은 기상청 전용이라 이 값이 없으면 **503**이다.
#    빈 키를 KmaError로 올리고 창구가 그걸 503으로 바꾼다(routers/weather.py get_forecast).
#    즉 "지금 날씨는 뜨는데 예보만 안 뜬다"가 이 값이 비었다는 신호다.
#
# ⭐ 인증키는 **디코딩 판(88자, `==`로 끝나는 것)을 넣는다.** 포털이 같이 주는 인코딩 판
# (92자, `%3D%3D`로 끝남)을 넣으면 라이브러리가 %를 한 번 더 인코딩해서
# SERVICE_KEY_IS_NOT_REGISTERED_ERROR가 떨어진다(HTTP는 200이라 로그만 보면 모른다).
# 잘못 넣어도 app/weather.py가 한 번 풀어 주지만, 처음부터 디코딩 판을 넣는 게 맞다.
# ⚠ 실키는 팀 비밀 저장소에서 받아 이 파일이 아니라 .env에만 넣는다(이 파일은 커밋된다).
KMA_SERVICE_KEY=
# 기상청 격자 좌표. 기본값은 **5번 게이트(광주 광산구 하남산단6번로 133) 칸인 57·75다.**
# ⚠ 2026-08-04 정정 — 08-03에 적어 뒀던 58·74는 광주 시청(서구 치평동) 칸이다. 격자가 5km라
# 같은 광주 안에서도 갈리고, 같은 시각 실황이 시청 28.5도·습도 75% / 게이트 27.1도·습도 98%로
# 실제로 달랐다. 코드 기본값이 이미 57·75라 **여기는 안 적는 게 맞다** — 다른 지점을 볼 때만 쓴다.
# KMA_NX=57
# KMA_NY=75
# 오퍼레이션 앞까지의 주소. 뒤에 /getUltraSrtNcst·/getUltraSrtFcst가 붙는다.
# KMA_BASE_URL=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0
# 이 이상이면 HEAVY_RAIN(mm/h). 실내·실외 판정은 안 갈리고 화면 칩 문구만 갈라진다.
# KMA_HEAVY_RAIN_MM=3.0
# 주기 조회 간격(초). 5분이면 오퍼레이션 둘 합쳐 하루 576건이라 한도(각 1만)의 6%다.
# 0 이하로 두면 주기 조회를 끄고 예전처럼 그날 첫 물음이 조회를 태운다.
# WEATHER_POLL_INTERVAL_SEC=300
# 기상청이 죽었을 때 예전 경로(wttr.in → wttr.is)로 물러설까. 끄면 바로 마지막 성공값이다.
# WEATHER_WTTR_FALLBACK_ENABLED=true
# 폴백 사슬 주소. 기상청이 1차라 이제는 둘째·셋째 고리다.
# ⚠ 이 줄을 적되 값을 비우면(`WEATHER_API_URL=`) 기본값으로 안 돌아가고 빈 주소를 한 번 헛돈 뒤
# 아래 대체 도메인이 대신 받는다 — "날씨 1차 조회 실패, 대체 도메인이 받았다" 경고가 늘 뜬다.
# WEATHER_API_URL=https://wttr.in/Gwangju?format=j1
# 같은 운영자가 둔 대체 도메인(셋째 고리). 비우면 사슬이 둘째에서 끝난다(여기는 빈 값이 정상 갈래다).
# WEATHER_API_FALLBACK_URL=https://wttr.is/Gwangju?format=j1
# WEATHER_TIMEOUT_SEC=4.0
# ⛔ 날씨가 기본 목적지를 자동으로 바꿀까. **시연 기간에는 꺼 둔다**(2026-08-03 사용자 확정).
# 끄면 날씨 조회·화면 갱신은 그대로 돌고 목적지만 안 건드린다 — 칩은 실제 날씨를 계속 보여준다.
# 왜 껐나 — 실내 태깅 도착 태그가 시연 배치에 없어서, 비가 오면 서버는 실내로 넘기는데 젯슨은
# 그 명령을 외부 경로로 태운다. 게다가 한 방향 걸쇠라(비가 그쳐도 안 되돌림) 아침 소나기 한 번이
# 그날을 통째로 잠근다. 시연이 끝나고 실내 지점이 생기면 켠다.
# WEATHER_AUTO_DEFAULT_ENABLED=false
# 시간대별 예보(GET /api/weather/forecast)를 몇 초 동안 다시 안 부를까. 예보가 1시간 단위라
# 짧게 잡을 이유가 없다. 0이면 매 요청이 바깥을 탄다.
# WEATHER_FORECAST_CACHE_SEC=600
# 예보를 며칠치 줄까(1이면 오늘만). ⚠ **지금은 적어도 아무 일도 안 일어난다** — 창구가 이 설정을
# 안 읽고 app/weather.py의 상수 FORECAST_DAYS=2를 쓴다(2026-08-04 실측, 읽는 자리 0건).
# 며칠치를 바꾸려면 지금은 코드를 고쳐야 한다.
# WEATHER_FORECAST_DAYS=2

# ── 실시간 카메라 프록시 (2026-08-03, S15P11C207-398) ────────────────────────
# ⭐ 젯슨 미리보기(MJPEG) 주소. **발표장 망이 바뀌면 여기만 고친다.**
# ⚠ 안 적으면 코드에 박힌 사설 IP(http://192.168.0.13:8090/stream)로 나가서, 망이 다른 자리에서는
# 화면이 502로 뜬 뒤에야 원인을 찾게 된다. 거절은 안 하고 경고 로그만 남긴다 — 첫 요청 때
# "카메라 상류 주소가 기본값 그대로다" 줄이 뜨면 아직 아무도 안 정한 상태다(routers/camera.py).
# ⛔ **주소를 아직 모르겠다고 `CAMERA_STREAM_URL=`로 비워 두지 마라.** 빈 값은 위 기본값으로
# 안 돌아가고 빈 주소로 그대로 나가서 카메라 창이 **502**다(httpx UnsupportedProtocol을
# routers/camera.py가 502로 바꾼다, 2026-08-04 실측). 안 정했으면 줄을 통째로 지운다 —
# 그러면 기본값으로 돌고 경고 줄만 뜬다. 같은 절의 숫자 셋은 비우면 서버가 기동을 못 한다.
# CAMERA_STREAM_URL=http://192.168.0.13:8090/stream
# 동시 접속 상한. 넘치면 503이다. 젯슨이 매 프레임 JPEG를 인코딩해서 여럿이 붙으면 주행 중
# 태그 검출이 밀린다. ⚠ 카운터가 프로세스 안 변수라 워커를 늘리면 그만큼 곱해진다
# (지금 Dockerfile이 --workers 1이다. 늘리면 첫 요청에 경고 줄이 뜬다).
# CAMERA_MAX_VIEWERS=3
# 상류 연결 타임아웃(초). "젯슨이 꺼져 있다"를 빨리 알아채는 값이라 짧게 잡는다.
# CAMERA_CONNECT_TIMEOUT_SEC=3.0
# 프레임 읽기 타임아웃(초). 젯슨 프레임 간격이 0.01초라 5초면 넉넉하다.
# CAMERA_READ_TIMEOUT_SEC=5.0

# ── 출동 창구 (/api/dispatch/*) ──────────────────────────────────────────────
# X-API-Key를 요구할까. 기본 false다 — 지금 배포는 이 창구가 무인증이라 curl 한 줄로 로봇을
# 보내거나 세울 수 있다(전체검토 D11). ⚠ 켜는 순간 관제 화면도 키를 실어야 붙는다.
# 켤지는 팀·사용자 결정 자리라 여기서는 기본값만 적어 둔다.
# DISPATCH_REQUIRE_API_KEY=false
# 즉시 이동·복귀를 이 초 안에 다시 부르면 429(Retry-After 포함). 인증이 없는 창구라 이게 유일한
# 유량 제한이다. ⚠ 긴급정지 창구는 여기서 빠진다 — 세우기도 풀기도 막히면 안 된다. 0 이하면 끈다.
# DISPATCH_COMMAND_MIN_INTERVAL_SEC=1.0

# ── 로그인 (로그인 설계 확정본 2026-08-01 §1·§6.2) ───────────────────────────
# ⭐ 아래 값을 하나도 안 적으면 지금 배포 거동 그대로다. 로그인 스위치가 기본 false라
# 창구 거동이 글자 그대로 지금과 같고, 로그인 창구(/api/auth/*)만 늘 살아 있다.
#
# ⚠ 켜는 순서를 지킨다 — ①플래그를 끈 채로 배포 + 마이그레이션 ②계정 심기
# (backend/tools/seed_users.py) ③관리자로 로그인 실측 ④프론트 배포 ⑤여기를 true로.
# 2단계를 건너뛰고 켜면 아무도 못 들어가는 잠금이 난다. 되돌리기는 이 값 하나를 false로
# 되돌리는 것뿐이다 — 다른 값은 롤백에 안 건드린다.
# AUTH_REQUIRE_LOGIN=false
# 세션 쿠키에 Secure를 붙일까(기본 true). 배포는 443+certbot이라 true 그대로 둔다.
# ⚠ http로 도는 로컬 개발에서 true면 브라우저가 쿠키를 아예 저장하지 않아, 서버는 멀쩡한데
# 로그인이 매번 튕긴 것처럼 보인다. 그 자리에서만 false로 내린다.
# SESSION_COOKIE_SECURE=true
# 절대 만료(초). 발급 시각 + 이 값이고 어떤 활동으로도 안 늘어난다. 기본 12시간.
# SESSION_ABSOLUTE_TTL_SEC=43200
# 유휴 만료(초). 마지막 활동 + 이 값. 활동하면 밀린다. 기본 2시간.
# SESSION_IDLE_TTL_SEC=7200
# 마지막 활동 시각을 다시 쓰는 최소 간격(초). 화면이 주기로 조회를 때리므로 매 요청마다
# 쓰지 않는다(세션 표 쓰기 폭주 방어).
# SESSION_TOUCH_MIN_INTERVAL_SEC=60
# 만료된 세션 행을 몇 일 뒤에 지울까. 지우는 자리는 로그인 창구 하나고 별도 크론이 없다.
# SESSION_PURGE_AFTER_DAYS=7
# 한 계정이 동시에 들 수 있는 세션 수. 넘치면 로그인할 때 오래된 것부터 무효화한다.
# 관제 화면·노트북·폰을 겹쳐 써도 안 걸리는 선으로 잡았다. 0이면 상한을 끈다.
# SESSION_MAX_PER_USER=5
# 로그인 실패 잠금 — 계정당 이 횟수만큼 연속 실패하면 아래 초만큼 잠근다.
# ⚠ 시연 중 오타로 잠기는 게 더 나쁘면 늘린다. 잠금은 프로세스 메모리에 있어 재기동하면 풀린다.
# LOGIN_FAIL_MAX_ATTEMPTS=5
# LOGIN_FAIL_LOCK_SEC=60
# 교차 오리진 상태변경(POST·PUT·PATCH·DELETE)을 막는 보강 한 겹이 **추가로** 받아 줄 오리진.
# 콤마로 여럿 적는다. 비워 두는 게 기본이고 그때는 자기 오리진 + 로컬 오리진만 통과한다 —
# 배포는 화면과 창구가 같은 오리진이라 안 적어도 그대로 돈다.
# ⚠ 로컬 개발(정적 서버를 몇 번 포트로 띄우든)은 **여기 안 적어도 된다.** localhost·127.0.0.1은
# 포트·스킴과 무관하게 기본 허용이다(app/security.py origin_allowed에 근거가 있다).
# 그래서 이 값이 필요한 건 로컬이 아닌 다른 오리진에서 화면을 띄울 때뿐이고, 그때는
# 스킴·포트까지 정확히 적는다(https://a.example과 https://a.example:8443은 다른 오리진이다).
# ⚠ Origin 헤더가 없는 요청(젯슨 인입·curl·젠킨스)은 이 값과 무관하게 통과한다.
# AUTH_ALLOWED_ORIGINS=https://c207.example
