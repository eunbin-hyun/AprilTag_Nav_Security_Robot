<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>web_bridge</name>
  <version>0.0.0</version>
  <description>
    ROS 2 상태 토픽을 웹 관제용 WebSocket 메시지로 변환하는 브리지.
  </description>
  <maintainer email="eunbin-hyun@users.noreply.github.com">eunbin-hyun</maintainer>
  <!-- 팀 공통 라이선스 정책이 정해지면 교체 -->
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <exec_depend>python3-websockets</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <depend>std_srvs</depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
