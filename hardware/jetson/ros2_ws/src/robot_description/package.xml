  </description>
  <maintainer email="eunbin-hyun@users.noreply.github.com">eunbin-hyun</maintainer>
  <!-- 팀 공통 라이선스 정책이 정해지면 교체 -->
  <license>Apache-2.0</license>

  <test_depend>ament_copyright</test_depend>
