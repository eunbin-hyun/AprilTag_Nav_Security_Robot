# 라즈베리파이 게이트 클라이언트 설정 예시.
# 이 파일을 .env 로 복사해서 값만 바꿔 쓴다 (.env 는 hardware/.gitignore 로 커밋 제외).
#   cp .env.example .env
# gate_server.py 가 실행 폴더의 .env 를 읽으므로 hardware/rpi 안에서 실행한다.

# 관제 서버 주소. 끝의 / 는 있어도 되고 없어도 된다.
# 배포 예시: https://robot.example.com   /   로컬 백엔드: http://localhost:8000
SERVER_BASE_URL=http://localhost:8000

# 서버 인입 API 공용 인증 키. X-API-Key 헤더로 실려 나간다.
# 실제 값은 팀 비밀 저장소에서 받아 이 파일이 아니라 .env 에만 넣는다.
API_KEY=여기에-키를-넣는다

# 이 라즈베리파이의 장치 식별자. 서버 이벤트에 그대로 실린다.
DEVICE_ID=raspberry01

# 이 기기가 담당하는 게이트 번호(정수).
GATE_NO=5

# 코드 생성 알림음을 재생할 명령. 블루투스 스피커를 시스템 기본 출력으로 연결한다.
SOUND_COMMAND=ffplay -nodisp -autoexit -loglevel error -f wav -i -

# 서버가 라즈베리파이에 내리는 명령을 폴링할 창구.
# 응답 예: {"commands":[{"command_id":"cmd-1","type":"bus_arrival"}]}
RPI_COMMAND_POLL_ENDPOINT=/api/rpi/commands/poll
RPI_COMMAND_ACK_ENDPOINT=/api/rpi/commands/{command_id}/ack

# 파일 음원을 재생할 명령과 음원 파일. 상대 경로는 hardware/rpi 기준입니다.
FILE_SOUND_COMMAND=ffplay -nodisp -autoexit -loglevel error
TAG_SOUND_FILE=tag.wav
BUS_ARRIVAL_SOUND_FILE=bus_arrival.wav
ROBOT_DEPARTURE_SOUND_FILE=robot_departure.wav
ROBOT_ARRIVAL_SOUND_FILE=robot_arrival.wav
ROBOT_RETURN_COMPLETE_SOUND_FILE=robot_return_complete.wav
